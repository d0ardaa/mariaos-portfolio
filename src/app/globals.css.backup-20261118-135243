:root {
  --desktop: #010201;
  --desktop-dark: #11130e;
  --navy: #85a957;
  --navy-light: #abc97b;
  --charcoal: #e9f4d8;
  --paper: #10170f;
  --canvas: #151d12;
  --window: #293623;
  --muted: #a5b695;
  --pink: #d2f594;
  --mint: #abc97b;
  --yellow: #c4e786;
  --border-dark: #0b1308;
  --ph-black: #010201;
  --ph-deep: #11130e;
  --ph-olive: #262b1e;
  --ph-moss: #3f4831;
  --ph-sage: #5b6745;
  --ph-mid: #8da467;
  --ph-soft: #abc97b;
  --ph-light: #d2f594;
  --ph-text: #e9f4d8;
}

html, body { background-color: var(--ph-black); }
body { color: var(--ph-text); }
::selection { background: #d2f594; color: #10170b; }
button:focus-visible, a:focus-visible { outline-color: var(--ph-light); }

/* Desktop: brilho fosforescente e textura de pixels, sem precisar de imagens. */
.wallpaper {
  background-color: #030602;
  background-image:
    radial-gradient(ellipse 48% 65% at 75% 59%, rgba(169,211,111,.30), transparent 70%),
    radial-gradient(ellipse 33% 55% at 26% 25%, rgba(117,155,71,.21), transparent 76%),
    radial-gradient(ellipse 32% 34% at 51% 94%, rgba(110,157,74,.12), transparent 84%),
    linear-gradient(135deg, #020402 0%, #11180d 50%, #030502 100%);
}
.wallpaper::after {
  display: block;
  content: '';
  position: absolute;
  inset: 0;
  opacity: .18;
  pointer-events: none;
  background-image: radial-gradient(circle, #b4db80 0.65px, transparent 0.95px);
  background-size: 4px 4px;
  mask-image: none;
}
.wallpaper-grid, .wallpaper-grid::before, .wallpaper-grid::after { border-color: rgba(173,216,111,.18); }
.wallpaper-orb { border-color: rgba(212,245,148,.7); }
.desktop-icon { color: var(--ph-text); }
.desktop-icon:hover, .desktop-icon:focus-visible {
  background: rgba(117,160,71,.28);
  outline-color: var(--ph-light);
}
.desktop-icon svg { filter: sepia(.6) hue-rotate(36deg) saturate(.7) drop-shadow(2px 2px 0 #000); }
.desktop-icon span { text-shadow: 1px 2px 2px #000; }
.desktop-sticker { color: #c6dea8; }
.desktop-sticker .sticker-spark, .desktop-sticker strong { color: var(--ph-light); }

/* Janelas: bordas em relevo no estilo Win98, com tonalidade verde-oliva. */
.window {
  background: var(--ph-olive);
  border-color: #90a975 #0b1008 #0b1008 #90a975;
  box-shadow: 1px 1px 0 #000, 3px 3px 0 rgba(0,0,0,.65), 13px 17px 0 rgba(0,0,0,.25);
}
.titlebar {
  background: linear-gradient(90deg, #23351b 0%, #456331 65%, #7ca354 100%);
  color: #f3ffd8;
  border-bottom: 1px solid #13220f;
}
.titlebar-label { color: #f5ffdb; }
.control {
  background: #9eaf89;
  color: #10170c;
  border-color: #dfebc7 #26331c #26331c #dfebc7;
  box-shadow: inset 1px 1px #c6d4b2;
}
.control:hover { background: #c2dda0; }
.control:active { background: #80996b; border-color: #26331c #dfebc7 #dfebc7 #26331c; }
.menubar { color: #e1edcb; }
.menubar-tip { color: #adca80; }
.statusbar { color: #c9d8ad; }
.statusbar span { border-color: #131b11 #6c8061 #6c8061 #131b11; }
.window-inner, .projects-content, .detail-content, .about-content,
.stack-content, .contact-content, .readme-content {
  background: var(--ph-deep);
  border-color: #070c06 #718663 #718663 #070c06;
}

/* Botoes e textos gerais. */
.win-button {
  background: #3d4d30;
  color: #edf9d5;
  border-color: #849a6e #141e0e #141e0e #849a6e;
  box-shadow: inset 1px 1px #667c53, 2px 2px 0 rgba(0,0,0,.5);
}
.win-button:hover { background: #536d3c; color: #f4ffdc; }
.win-button:active { background: #2b3c22; border-color: #141e0e #849a6e #849a6e #141e0e; }
.win-button--primary {
  background: #c4e78b;
  color: #13200c;
  border-color: #efffca #517135 #517135 #efffca;
  box-shadow: inset 1px 1px #e3f9bc, 2px 2px 0 rgba(0,0,0,.55);
}
.win-button--primary:hover { background: #d2f594; color: #0f1a09; }
.section-overline { color: #a1c776; }
.dot-pink, .cursor-block { color: var(--ph-light); }
.eyebrow { color: #bfdc9b; }
.eyebrow-led, .green-dot { background: var(--ph-light); border-color: #648945; box-shadow: 0 0 6px rgba(210,245,148,.4); }
.eyebrow-divider { color: #597548; }

/* Tela de boas-vindas. */
.welcome-left { background: #10170f; }
.welcome-kicker { color: #d2f594; }
.welcome-left h1 { color: #ecffd0; }
.welcome-left h1 span:not(.cursor-block) { color: #d2f594; }
.welcome-description { color: #c7d8b6; }
.welcome-description strong { color: #d8f7aa; }
.welcome-foot { color: #abc28f; }
.welcome-right { background: #1b2616; border-left-color: #425d32; }
.welcome-right::before { background: rgba(135,173,83,.14); }
.welcome-right::after { background-image: radial-gradient(#bfd98f 1px, transparent 1px); opacity: .13; }
.art-stars, .art-stars span { color: #c1e78b; }
.screen-card {
  background: #232f1c;
  border-color: #859b6a;
  box-shadow: 0 0 0 3px #050a04, 12px 13px 0 rgba(0,0,0,.3);
}
.screen-top { background: #3a5430; color: #f0ffd6; }
.screen-content { background: #030902; }
.screen-hello, .screen-prompt { color: #d2f594; }
.screen-line { background: #4d6440; }
.screen-line--lg { background: #abc97b; }
.screen-line--sm { background: #7d9d58; }
.float-card { background: #26351f; border-color: #759557; color: #e6fcc2; box-shadow: 4px 5px 0 #0b1308; }
.float-card--bottom { background: #334927; box-shadow: 4px 5px 0 #101909; }
.retro-art-caption { color: #c6e29e; }
.figure-photo-frame { background: #1b2716; border-color: #b0c995 #10180d #10180d #b0c995; box-shadow: 7px 8px 0 rgba(0,0,0,.42); }
.figure-photo-titlebar { background: linear-gradient(90deg,#2a451d,#729851); color: #f3ffd7; }
.figure-photo-frame > img { border-color: #678654; }
/* Fotos pessoais, bandeiras e imagens dos projetos sao mantidas nas cores originais. */

/* Explorador de projetos. */
.explorer-address { color: #c7d9ad; }
.explorer-address > div { background: #172213; color: #e6f5d3; border-color: #060a04 #6b875b #6b875b #060a04; }
.explorer-sidebar { background: #202d1a; border-right-color: #506344; }
.sidebar-heading { color: #a6c086; }
.folder-filter { color: #d2e5ba; }
.folder-filter span { color: #a7c787; }
.folder-filter:hover { background: #3c5330; }
.folder-filter.active {
  background: #b6d984;
  color: #14230c;
  border-color: #f1ffda #506b37 #506b37 #f1ffda;
  box-shadow: 1px 1px 0 #0c1408;
}
.folder-filter.active span { color: #29441c; }
.sidebar-lower { background: #344329; color: #e2efcc; border-color: #789851; }
.explorer-main { background: #11190e; }
.projects-heading h2, .stack-content h2, .about-top h2,
.detail-top h2, .contact-banner h2 { color: #e8f8d1; }
.project-counter { background: #27361e; color: #c7dfae; border-color: #5e7b47; }
.demo-notice { background: #30371e; color: #e2eebf; border-left-color: #c7e890; }
.demo-notice code, .contact-hint code { background: rgba(191,228,139,.15); }
.project-card {
  background: #1b2617;
  color: #e9f4d8;
  border-color: #637a51;
  box-shadow: 3px 3px 0 #080c06;
}
.project-card:hover, .project-card:focus-visible {
  background: #24351d;
  box-shadow: 5px 5px 0 #090f07;
}
.card-topline { background: #7c9c5e; }
.project-card[data-category="sistemas"] .card-topline { background: #d2f594; }
.project-card[data-category="automacoes"] .card-topline { background: #a6cf71; }
.project-card[data-category="dados"] .card-topline { background: #638b4c; }
.card-illustration { background: #314227; border-color: #71965a; }
.card-kind { color: #a2c47a; }
.card-title { color: #eaffcf; }
.card-summary { color: #c2d1ad; }
.card-tag { background: #324729; color: #d6ecb8; }
.card-arrow { color: #d2f594; }

/* Detalhes dos projetos. */
.detail-icon { background: #293d20; border-color: #718c5d; }
.detail-description, .detail-list { color: #d1e0bc; }
.detail-section-title { color: #d2f594; border-bottom-color: #5f784f; }
.detail-tags span { background: #293d20; color: #d8edb5; border-color: #5c7b45; }
.detail-empty { color: #abc18f; }

/* Sobre mim. */
.profile-avatar { background: #2e4522; border-color: #8dab6f; box-shadow: 5px 5px 0 #070b06; }
.about-top p, .about-bio { color: #cadbb6; }
.dotted-rule { border-bottom-color: #6f8b54; }
.about-facts { border-color: #617752; }
.about-facts > div { background: #24301d; border-right-color: #617752; border-bottom-color: #617752; }
.about-facts small { color: #a5c18a; }
.about-facts strong { color: #efffd3; }

/* Tecnologias e badges (tambem cobre a extensao com React Icons). */
.stack-content > p { color: #bdd0a6; }
.stack-group { background: #1c2a17; border-color: #587449; }
.stack-group-head { color: #e4f8cd; }
.tag-cloud span, .tag-cloud .technology-badge {
  background: #273921;
  border-color: #829b69;
  color: #e8f5d5;
  box-shadow: 2px 2px 0 #0a0f08;
}
.tag-cloud .technology-badge:hover { background: #3b5730; }
.tag-cloud .technology-badge .tech-icon { color: #d2f594 !important; }
.tag-cloud .technology-badge img.tech-icon {
  filter: grayscale(1) brightness(0) invert(89%) sepia(21%) saturate(680%) hue-rotate(33deg) brightness(108%) contrast(93%);
}

/* Contato e arquivo README. */
.contact-content > p { color: #c7d8b3; }
.mail-fields { border-top-color: #647b53; border-bottom-color: #647b53; }
.mail-fields > div { border-bottom-color: #4a6140; }
.mail-fields label { color: #d4ebae; }
.mail-fields span { color: #ddecc7; }
.contact-content > .contact-hint { color: #b0c598; }
.readme-content pre { color: #d5eac0; }

/* Barra de tarefas, iniciar, idioma e notificacoes. */
.taskbar {
  background: #26341e;
  border-top-color: #8da776;
  box-shadow: 0 -1px #091108, 0 -8px 22px rgba(0,0,0,.3);
}
.start-button, .taskbar-app {
  background: #405333;
  color: #e9f8d4;
  border-color: #a9c290 #142010 #142010 #a9c290;
  box-shadow: inset 1px 1px #688458, 1px 1px #070b05;
}
.start-button:hover, .taskbar-app:hover { background: #4d683a; }
.start-button.is-active, .taskbar-app.is-active {
  background: #678952;
  color: #fbffe8;
  border-color: #15250d #bddca4 #bddca4 #15250d;
  box-shadow: inset 1px 1px 2px #1a3012;
}
/* As quatro pecas do emblema Win98 recebem quatro tons da MESMA paleta. */
.win-mark i:nth-child(1) { background: #d2f594; }
.win-mark i:nth-child(2) { background: #abc97b; }
.win-mark i:nth-child(3) { background: #799e54; }
.win-mark i:nth-child(4) { background: #567a40; }
.taskbar-divider { border-left-color: #15210e; border-right-color: #849c72; }
.taskbar-tray { background: #1b2916; color: #eafad4; border-color: #0c1609 #78966a #78966a #0c1609; }
.tray-signal { color: #d2f594; }
.start-menu { background: #28381f; border-color: #b3c7a0 #0b1207 #0b1207 #b3c7a0; box-shadow: 3px 3px 0 #020402; }
.start-menu-brand { background: #12220d; color: #d6f7a6; }
.start-menu-brand strong { color: #abc97b; }
.start-menu-title { color: #9fbc84; }
.start-menu-links button { color: #e5f4d2; }
.start-menu-links button:hover, .start-menu-links button:focus-visible { background: #b3d982; color: #16230e; }
.start-menu-divider { background: #111a0c; border-bottom-color: #78936b; }
.language-switcher {
  background: #26351e;
  border-color: #b0cba0 #0b1207 #0b1207 #b0cba0;
  box-shadow: 3px 3px 0 rgba(0,0,0,.6);
}
.language-heading { color: #e8f9cf; }
.language-button { background: #394c2d; color: #e5f5d1; border-color: #97b383 #15240e #15240e #97b383; }
.language-button:hover { background: #5f7e44; }
.language-button.is-selected {
  background: #c4e78b;
  color: #16240d;
  border-color: #4c6c36 #f0ffd5 #f0ffd5 #4c6c36;
}
.route-redirect { color: #d2f594; }
.route-redirect a { color: #d2f594; border-color: #d2f594; }
.toast { background: #314924; color: #f3ffd8; border-color: #9cbb77; box-shadow: 4px 4px 0 rgba(0,0,0,.4); }

/* Fotos do perfil: somente a moldura, nunca os pixels da foto. */
.desktop-icon > img.profile-photo { border-color: #bcd997; outline-color: #1b2c16; }
.titlebar-label > img.profile-photo { border-color: #c0d99a; }
.start-menu-links button > img.profile-photo,
.taskbar-app > img.profile-photo { border-color: #8da776; }
