  .window, .window--welcome, .window--projects, .window--details, .window--about, .window--stack, .window--contact, .window--readme { left: 8px !important; top: 154px !important; width: calc(100vw - 16px) !important; height: calc(100dvh - 207px) !important; min-height: 0; max-height: none; }
  .window.is-maximized { left: 4px !important; top: 5px !important; width: calc(100vw - 8px) !important; height: calc(100dvh - 51px) !important; }
  .titlebar { touch-action: auto; cursor: default; }
  .menubar { gap: 11px; font-size: 11px; min-height: 28px; }
  .menubar-tip { display: none; }
  .welcome-inner { grid-template-columns: 1fr; overflow-y: auto; }
  .welcome-left { padding: 22px 21px 20px; }
