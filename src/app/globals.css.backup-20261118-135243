  .project-card .card-body { min-height: 153px; }
  .statusbar span:last-child { min-width: auto; }
  .explorer-address { gap: 5px; }
  .explorer-address > span { display: none; }
  .explorer-address > div { font-size: 10px; }
  .explorer-address > button { display: none; }
  .projects-heading h2 { font-size: 22px; }
  .projects-heading { align-items: center; }
