  .welcome-description { max-width: 560px; }
  .welcome-foot { padding-top: 20px; }
  .welcome-right { display: none; }
  .projects-content { grid-template-columns: 1fr; display: flex; flex-direction: column; }
  .explorer-sidebar { flex: 0 0 auto; display: flex; flex-direction: row; gap: 5px; overflow-x: auto; padding: 8px; }
  .sidebar-heading, .sidebar-lower { display: none; }
  .folder-filter { width: auto; min-width: max-content; padding: 6px 9px; font-size: 11px; }
  .folder-filter svg { width: 21px; height: 21px; }
