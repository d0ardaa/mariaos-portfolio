  .start-menu { width: min(275px, calc(100vw - 10px)); }
}
@media (max-width: 480px) {
  .window--welcome .menubar { display: none; }
  .window--welcome { top: 128px !important; height: calc(100dvh - 181px) !important; }
  .desktop-icons { grid-template-columns: repeat(3, 73px); }
  .projects-grid { grid-template-columns: 1fr; }
