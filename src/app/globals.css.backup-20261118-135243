/* MariaOS 98 v2: language selector + UX refinements */
.language-switcher { position: fixed; z-index: 950; right: 16px; top: 13px; background: #c5c7c6; padding: 7px 9px; display: flex; align-items: center; gap: 10px; border: 2px solid; border-color: #fff #41434c #41434c #fff; box-shadow: 3px 3px 0 rgba(0, 25, 35, .45); }
.language-heading { color: #283457; font-size: 11px; font-weight: 700; font-family: var(--pixel-font); white-space: nowrap; }
.language-options { display: flex; gap: 4px; }
.language-button { min-width: 43px; height: 32px; padding: 2px 5px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #e4e4dc; color: #2e3549; text-decoration: none; border: 1px solid; border-color: #fff #5a5d65 #5a5d65 #fff; font-family: var(--pixel-font); font-size: 10px; line-height: 1.1; }
.language-button span:first-child { font-size: 18px; line-height: 1; }
.language-button:hover { background: #fffbe5; }
.language-button.is-selected { background: #263e88; color: white; border-color: #111b51 #e6eaf9 #e6eaf9 #111b51; }
.language-button:focus-visible { outline-offset: 3px; }
.is-disabled { opacity: .7; }
.route-redirect { min-height: 100dvh; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: var(--pixel-font); color: #fff; gap: 15px; }
.route-redirect a { color: #fff; padding: 10px; border: 2px solid white; text-decoration: none; }
@media (max-width: 780px) {
  .language-switcher { top: 7px; right: 7px; gap: 3px; padding: 4px; }
  .language-heading { display: none; }
  .language-button { min-width: 37px; width: 37px; height: 34px; }
  .desktop-icons { grid-template-columns: repeat(2, 76px); gap: 1px 6px; }
  .window, .window--welcome, .window--projects, .window--details, .window--about, .window--stack, .window--contact, .window--readme { top: 194px !important; height: calc(100dvh - 247px) !important; }
}
@media (max-width: 480px) {
  .window--welcome { top: 194px !important; height: calc(100dvh - 247px) !important; }
}

/* Keep close/maximize controls accessible when a window fills the screen. */
.language-switcher.is-docked { top: auto; bottom: 54px; }

.language-button img { display: block; width: 24px; height: 16px; border: 1px solid rgba(0,0,0,.22); object-fit: cover; }

/* Personalização de fotos: mantenha a estética Windows 98 */
.desktop-icon > img.profile-photo { width: 46px; height: 46px; flex: 0 0 46px; object-fit: cover; border: 2px solid #f9f4e8; outline: 1px solid #29385b; box-shadow: 2px 2px 0 rgba(0, 0, 0, .3); }
.profile-avatar > img.profile-photo { width: 100%; height: 100%; object-fit: cover; display: block; }
.titlebar-label > img.profile-photo { width: 22px; height: 22px; object-fit: cover; border: 1px solid #f9f4e8; flex: 0 0 22px; }
.start-menu-links button > img.profile-photo { width: 26px; height: 26px; object-fit: cover; border: 1px solid #90959a; }
.taskbar-app > img.profile-photo { width: 21px; height: 21px; object-fit: cover; border: 1px solid #90959a; flex: 0 0 21px; }
.figure-photo-frame { width: min(82%, 330px); aspect-ratio: 4 / 5; max-height: 78%; background: #fff8eb; padding: 6px; display: flex; flex-direction: column; border: 2px solid; border-color: #fff #3b3d50 #3b3d50 #fff; box-shadow: 7px 8px 0 rgba(69, 49, 72, .2); transform: rotate(-2deg); }
.figure-photo-titlebar { height: 27px; flex: 0 0 27px; display: flex; justify-content: space-between; align-items: center; padding: 0 8px; background: linear-gradient(90deg, #182c85, #5a89bc); color: white; font: bold 11px var(--pixel-font); }
.figure-photo-frame > img { min-height: 0; min-width: 0; flex: 1; width: 100%; height: calc(100% - 27px); display: block; object-fit: cover; object-position: center; border: 2px solid #b4b5bb; }
@media (max-width: 780px) {
  .desktop-icon > img.profile-photo { width: 31px; height: 31px; flex-basis: 31px; }
  .figure-photo-frame { width: 190px; max-height: 210px; aspect-ratio: 4 / 5; }
}


